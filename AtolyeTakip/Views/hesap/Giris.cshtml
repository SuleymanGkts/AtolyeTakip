@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Giriş - Atölye Takip</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-8 col-md-5">
                <div class="card shadow border-0 rounded-3">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <h3 class="fw-bold text-primary">Atölye Takip</h3>
                            <p class="text-muted small">Personel / Mühendis Girişi</p>
                        </div>

                        @if (ViewBag.Hata != null)
                        {
                            <div class="alert alert-danger py-2 text-center">@ViewBag.Hata</div>
                        }

                        <form method="post" action="/Hesap/Giris">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Kullanıcı Adı</label>
                                <input type="text" name="kullaniciAdi" class="form-control form-control-lg" placeholder="Örn: ahmet" required autofocus />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Şifre</label>
                                <input type="password" name="sifre" class="form-control form-control-lg" placeholder="Şifrenizi girin" required />
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100 mt-2 fw-bold">GİRİŞ YAP</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>