@model List<AtolyeTakip.Models.Tezgah>
@{
    Layout = null;
    ViewData["Title"] = "Tezgah Yönetimi - Atölye Takip";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tezgah Yönetimi - Atölye Takip</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f6f9;
        }
    </style>
</head>
<body>

    <!-- Üst Mavi Menü -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary px-4 mb-4 shadow-sm">
        <a class="navbar-brand fw-bold fs-5 text-white text-decoration-none" href="/Muhendis/Index">⚙️ Atölye Yönetim Paneli</a>
        <div class="navbar-nav me-auto ms-3 d-flex flex-row gap-3">
            <a class="nav-link text-white-50" href="/Muhendis/Index">📊 Üretim Kayıtları</a>
            <a class="nav-link text-white-50" href="/Muhendis/Parcalar">📋 Parça &amp; Hedef Yönetimi</a>
            <a class="nav-link text-white active fw-bold border-bottom border-2 border-white pb-1" href="/Muhendis/Tezgahlar">🛠️ Tezgah Yönetimi</a>
            <a class="nav-link text-white-50" href="/Muhendis/Personeller">👥 Personel Yönetimi</a>
        </div>
        <a class="btn btn-outline-light btn-sm fw-semibold" href="/Hesap/Cikis">Çıkış Yap</a>
    </nav>

    <div class="container-fluid px-4 pb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">🛠️ Tezgah &amp; Makina Yönetimi</h3>
                <p class="text-muted small mb-0">Atölyedeki tezgahları ekleyin, adını düzenleyin veya silin.</p>
            </div>
            <a href="/Muhendis/Index" class="btn btn-outline-secondary fw-semibold shadow-sm">← Üretim Tablosuna Dön</a>
        </div>

        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                ✅ @TempData["Mesaj"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                ⚠️ @TempData["Hata"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Sol: Yeni Tezgah Ekle -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-dark text-white fw-bold py-3">➕ Yeni Tezgah Ekle</div>
                    <div class="card-body p-4">
                        <form method="post" action="/Muhendis/TezgahEkle">
                            @Html.AntiForgeryToken()

                            <div class="mb-4">
                                <label class="form-label fw-semibold small text-secondary">TEZGAH ADI</label>
                                <input type="text" name="tezgahAdi" class="form-control form-control-lg fs-6" required placeholder="Örn: CNC Torna 1" />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">+ Tezgahı Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sağ: Tanımlı Tezgahlar (Düzenle ve Sil Butonlarıyla) -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark">Kayıtlı Tezgahlar</h6>
                        <span class="badge bg-primary px-3 py-2 rounded-pill">@Model.Count Tezgah</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="text-start ps-4">Tezgah Adı</th>
                                    <th class="pe-4 text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="py-5 text-muted">Sistemde henüz kayıtlı tezgah yok.</td>
                                    </tr>
                                }
                                @foreach (var t in Model)
                                {
                                    <tr>
                                        <td class="text-start ps-4 fw-bold text-dark fs-6">
                                            ⚙️ @t.TezgahAdi
                                        </td>
                                        <td class="pe-4 text-end">
                                            <!-- Düzenle Butonu -->
                                            <button type="button" class="btn btn-sm btn-outline-primary px-3 me-1" data-bs-toggle="modal" data-bs-target="#duzenleModal-@t.Id">
                                                Düzenle
                                            </button>

                                            <!-- Sil Butonu -->
                                            <form method="post" action="/Muhendis/TezgahSil" onsubmit="return confirm('@t.TezgahAdi tezgahını silmek istediğinize emin misiniz?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@t.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-3">Sil</button>
                                            </form>
                                        </td>
                                    </tr>

                                    <!-- Tezgah Düzenleme Modal -->
                                    <div class="modal fade" id="duzenleModal-@t.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header bg-primary text-white">
                                                    <h5 class="modal-title fs-6 fw-bold">⚙️ Tezgah Düzenle</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form method="post" action="/Muhendis/TezgahGuncelle">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.Id" />

                                                    <div class="modal-body p-4">
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold small text-secondary">Tezgah Adı</label>
                                                            <input type="text" name="tezgahAdi" class="form-control" value="@t.TezgahAdi" required />
                                                        </div>
                                                    </div>

                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                                                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Güncelle</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>