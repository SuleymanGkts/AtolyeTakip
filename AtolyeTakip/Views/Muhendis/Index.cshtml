@model List<AtolyeTakip.Models.UretimKaydi>
@{
    Layout = null;
    ViewData["Title"] = "Üretim Kayıtları - Atölye Takip";

    var tezgahlar = ViewBag.Tezgahlar as List<AtolyeTakip.Models.Tezgah> ?? new();
    var personeller = ViewBag.Personeller as List<AtolyeTakip.Models.Kullanici> ?? new();

    var toplamSaglam = Model.Sum(k => k.SaglamMiktar);
    var toplamHurda = Model.Sum(k => k.HurdaMiktar);
    var toplamRework = Model.Sum(k => k.ReworkMiktar);
    var toplamUretim = toplamSaglam + toplamHurda + toplamRework;

    string excelUrl = $"/Muhendis/ExcelIndir?baslangic={ViewBag.Baslangic}&bitis={ViewBag.Bitis}&tezgah={ViewBag.SecilenTezgah}&personelId={ViewBag.SecilenPersonel}&vardiya={ViewBag.SecilenVardiya}";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atölye Yönetim Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f6f9;
        }
    </style>
</head>
<body>

    <!-- Üst Kurumsal Menü -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary px-4 mb-4 shadow-sm">
        <a class="navbar-brand fw-bold fs-5 text-white text-decoration-none" href="/Muhendis/Index">⚙️ Atölye Yönetim Paneli</a>
        <div class="navbar-nav me-auto ms-3 d-flex flex-row gap-3">
            <a class="nav-link text-white active fw-bold border-bottom border-2 border-white pb-1" href="/Muhendis/Index">📊 Üretim Kayıtları</a>
            <a class="nav-link text-white-50" href="/Muhendis/Parcalar">📋 Parça &amp; Hedef Yönetimi</a>
            <a class="nav-link text-white-50" href="/Muhendis/Tezgahlar">🛠️ Tezgah Yönetimi</a>
            <a class="nav-link text-white-50" href="/Muhendis/Personeller">👥 Personel Yönetimi</a>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Şifre Değiştir Butonu -->
            <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#sifreDegistirModal">
                🔑 Şifre Değiştir
            </button>
            <span class="text-white-50 small ms-1">Mühendis Oturumu</span>
            <a class="btn btn-outline-light btn-sm fw-semibold" href="/Hesap/Cikis">Çıkış Yap</a>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">

        <!-- Bildirim Mesajları -->
        @if (TempData["Mesaj"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                ✅ @TempData["Mesaj"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                ⚠️ @TempData["Hata"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Özet Kartları -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 bg-white">
                    <span class="text-muted small fw-bold">FİLTRELENEN TOPLAM ÜRETİM</span>
                    <h3 class="fw-bold text-primary mb-0">@toplamUretim <span class="fs-6 fw-normal text-muted">adet</span></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-success border-4 p-3 bg-white">
                    <span class="text-muted small fw-bold">SAĞLAM MİKTAR</span>
                    <h3 class="fw-bold text-success mb-0">@toplamSaglam <span class="fs-6 fw-normal text-muted">adet</span></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-danger border-4 p-3 bg-white">
                    <span class="text-muted small fw-bold">HURDA MİKTAR</span>
                    <h3 class="fw-bold text-danger mb-0">@toplamHurda <span class="fs-6 fw-normal text-muted">adet</span></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-warning border-4 p-3 bg-white">
                    <span class="text-muted small fw-bold">REWORK (YENİDEN İŞLEM)</span>
                    <h3 class="fw-bold text-warning mb-0">@toplamRework <span class="fs-6 fw-normal text-muted">adet</span></h3>
                </div>
            </div>
        </div>

        <!-- GELİŞMİŞ FİLTRELEME ALANI -->
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark">🔍 Rapor Filtreleme</h6>
                <span class="text-muted small">İstediğiniz kriterleri seçerek rapor oluşturabilirsiniz.</span>
            </div>
            <div class="card-body p-3">
                <form method="get" action="/Muhendis/Index" class="row g-3 align-items-end">

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Başlangıç Tarihi</label>
                        <input type="date" name="baslangic" class="form-control form-control-sm" value="@ViewBag.Baslangic" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Bitiş Tarihi</label>
                        <input type="date" name="bitis" class="form-control form-control-sm" value="@ViewBag.Bitis" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Tezgah / Makina</label>
                        <select name="tezgah" class="form-select form-select-sm">
                            <option value="">-- Tüm Tezgahlar --</option>
                            @foreach (var t in tezgahlar)
                            {
                                <option value="@t.TezgahAdi" selected="@(ViewBag.SecilenTezgah == t.TezgahAdi)">
                                    @t.TezgahAdi
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Personel / Usta</label>
                        <select name="personelId" class="form-select form-select-sm">
                            <option value="">-- Tüm Personeller --</option>
                            @foreach (var p in personeller)
                            {
                                <option value="@p.Id" selected="@(ViewBag.SecilenPersonel == p.Id)">
                                    @p.AdSoyad
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Vardiya</label>
                        <select name="vardiya" class="form-select form-select-sm">
                            <option value="">-- Tüm Vardiyalar --</option>
                            <option value="1. Vard" selected="@(ViewBag.SecilenVardiya == "1. Vard")">1. Vardiya (08:00 - 17:45)</option>
                            <option value="2. Vard" selected="@(ViewBag.SecilenVardiya == "2. Vard")">2. Vardiya (18:00 - 01:45)</option>
                            <option value="3. Vard" selected="@(ViewBag.SecilenVardiya == "3. Vard")">3. Vardiya (02:00 - 07:45)</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-primary btn-sm fw-bold flex-grow-1">Filtrele</button>
                        <a href="/Muhendis/Index" class="btn btn-outline-secondary btn-sm" title="Filtreleri Temizle">Temizle</a>
                    </div>
                </form>
            </div>

            <div class="card-footer bg-light p-2 px-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    📊 Tabloda <strong>@Model.Count</strong> kayıt listeleniyor.
                </span>
                <a href="@excelUrl" class="btn btn-success btn-sm fw-bold px-3 shadow-sm">
                    📥 Filtrelenmiş Excel Raporunu (.xlsx) İndir
                </a>
            </div>
        </div>

        <!-- Vardiya Üretim Kayıtları Tablosu -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Vardiya Üretim Kayıtları</h6>
                <span class="badge bg-secondary">@Model.Count Kayıt</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center small">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th>Tarih / Saat</th>
                            <th>Personel</th>
                            <th>Tezgah</th>
                            <th>Vardiya</th>
                            <th>Parça / İş</th>
                            <th>Hedef Mik.</th>
                            <th>Toplam</th>
                            <th>Sağlam</th>
                            <th>Hurda</th>
                            <th>Rework</th>
                            <th>Çalışma Saatleri</th>
                            <th>Açıklama</th>
                            <th class="pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="13" class="py-5 text-muted">Seçilen kriterlere uygun üretim kaydı bulunamadı.</td>
                            </tr>
                        }
                        @foreach (var k in Model)
                        {
                            var satirToplam = k.SaglamMiktar + k.HurdaMiktar + k.ReworkMiktar;
                            <tr>
                                <td>@k.KayitTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="fw-bold">@(k.Kullanici?.AdSoyad ?? "Bilinmiyor")</td>
                                <td><span class="badge bg-light text-dark border">⚙️ @(string.IsNullOrEmpty(k.TezgahAdi) ? "-" : k.TezgahAdi)</span></td>
                                <td>@k.Vardiya</td>
                                <td class="fw-bold text-dark">@k.ParcaAdi</td>
                                <td>@(k.HedefMiktar.HasValue? k.HedefMiktar.Value.ToString() : "-")</td>
                                <td class="fw-bold fs-6">@satirToplam</td>
                                <td class="text-success fw-bold">@k.SaglamMiktar</td>
                                <td class="text-danger fw-bold">@k.HurdaMiktar</td>
                                <td class="text-warning fw-bold">@k.ReworkMiktar</td>
                                <td>
                                    @(k.CalismaBaslangic != null || k.CalismaBitis != null
                                                                    ? $"{k.CalismaBaslangic?.ToString(@"hh\:mm")} - {k.CalismaBitis?.ToString(@"hh\:mm")}"
                                                                    : "Tam Vardiya")
                            </td>
                            <td class="text-muted text-start" style="max-width: 180px;">@(string.IsNullOrEmpty(k.Aciklama) ? "-" : k.Aciklama)</td>

                                <td class="pe-3">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#duzenleKayitModal-@k.Id">
                                            Düzenle
                                        </button>
                                        <form method="post" action="/Muhendis/KayitSil" onsubmit="return confirm('Bu üretim kaydını silmek istediğinize emin misiniz?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@k.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- Üretim Kaydı Düzenleme Modalı -->
                            <div class="modal fade" id="duzenleKayitModal-@k.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content text-start">
                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title fs-6 fw-bold">⚙️ Üretim Kaydını Düzenle</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form method="post" action="/Muhendis/KayitGuncelle">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@k.Id" />

                                            <div class="modal-body p-4">
                                                <div class="alert alert-light border small mb-3">
                                                    <div><strong>Personel:</strong> @(k.Kullanici?.AdSoyad ?? "-")</div>
                                                    <div><strong>Parça / İş:</strong> @k.ParcaAdi</div>
                                                    <div><strong>Vardiya:</strong> @k.Vardiya</div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold small text-secondary">Tezgah / Makina</label>
                                                    <select name="tezgahAdi" class="form-select form-select-sm" required>
                                                    @foreach (var t in tezgahlar)
                                                        {
                                                            <option value="@t.TezgahAdi" selected="@(k.TezgahAdi == t.TezgahAdi)">
                                                                @t.TezgahAdi
                                                            </option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="row g-2 mb-3">
                                                    <div class="col-4">
                                                        <label class="form-label small fw-bold text-success mb-1">Sağlam</label>
                                                        <input type="number" name="saglamMiktar" class="form-control form-control-sm text-center fw-bold" value="@k.SaglamMiktar" min="0" required />
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small fw-bold text-danger mb-1">Hurda</label>
                                                        <input type="number" name="hurdaMiktar" class="form-control form-control-sm text-center fw-bold" value="@k.HurdaMiktar" min="0" required />
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small fw-bold text-warning mb-1">Rework</label>
                                                        <input type="number" name="reworkMiktar" class="form-control form-control-sm text-center fw-bold" value="@k.ReworkMiktar" min="0" required />
                                                    </div>
                                                </div>

                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold text-secondary mb-1">Başlangıç Saati</label>
                                                        <input type="time" name="calismaBaslangic" class="form-control form-control-sm" value="@(k.CalismaBaslangic?.ToString(@"hh\:mm"))" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold text-secondary mb-1">Bitiş Saati</label>
                                                        <input type="time" name="calismaBitis" class="form-control form-control-sm" value="@(k.CalismaBitis?.ToString(@"hh\:mm"))" />
                                                    </div>
                                                </div>

                                                <div class="mb-2">
                                                    <label class="form-label fw-semibold small text-secondary mb-1">Açıklama</label>
                                                    <textarea name="aciklama" class="form-control form-control-sm" rows="2">@k.Aciklama</textarea>
                                                </div>
                                            </div>

                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                                                <button type="submit" class="btn btn-primary btn-sm fw-bold">Değişiklikleri Kaydet</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MÜHENDİS ŞİFRE DEĞİŞTİRME MODAL PENCERESİ -->
    <div class="modal fade" id="sifreDegistirModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-start border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fs-6 fw-bold">🔑 Yönetici / Mühendis Şifresi Değiştir</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/Muhendis/SifreDegistir">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">

                        <div class="alert alert-warning py-2 small mb-3 border-0">
                            🛡️ Bu işlem için özel sistem yetkilendirme kodunu girmelisiniz.
                        </div>

                        <!-- GÜVENLİK ŞİFRESİ -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-danger">GÜVENLİK ŞİFRESİ (Yetki Doğrulama)</label>
                            <input type="password" name="guvenlikKodu" class="form-control border-danger" required placeholder="Güvenlik kodunu giriniz..." />
                        </div>

                        <hr />

                        <!-- YENİ ŞİFRE -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary">Yeni Şifre</label>
                            <input type="password" name="yeniSifre" class="form-control" required minlength="4" placeholder="Yeni şifreniz (En az 4 karakter)" />
                        </div>

                        <!-- YENİ ŞİFRE TEKRAR -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold small text-secondary">Yeni Şifre (Tekrar)</label>
                            <input type="password" name="yeniSifreTekrar" class="form-control" required minlength="4" placeholder="Yeni şifrenizi tekrar giriniz" />
                        </div>

                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary btn-sm fw-bold px-3">Şifreyi Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>